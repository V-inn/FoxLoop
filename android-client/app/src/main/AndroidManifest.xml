<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shared by both products. Each flavor's own manifest (src/display,
         src/console) adds its activities, its accessory filter and whatever
         permissions that product needs, so nothing here may be one product's
         requirement.

         INTERNET is deliberately absent here. The display's shipped transport
         is AOA over USB, which needs no permission; the only networked path is
         the adb-forward one used during development, and its permission lives
         in src/displayDebug so release builds ask for nothing.

         required="true": without a USB accessory host neither app can do
         anything at all, so a store listing should be filtered to devices that
         can actually run it rather than offering it to everyone. -->
    <uses-feature android:name="android.hardware.usb.accessory" android:required="true" />

    <application
        android:allowBackup="false"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Black.NoTitleBar">
    </application>
</manifest>
