<?xml version="1.0" encoding="utf-8"?>
<!--
    The whole picture lives in the background layer and the foreground is
    empty, which is the opposite of the usual split.

    It is deliberate. The two layers exist so a launcher can move them against
    each other for a parallax effect, which suits an icon built as a subject
    sitting on a backdrop. This one is a single illustration, a fox climbing
    out of a laptop onto a tablet, and sliding any part of it away from the
    rest would pull the scene apart. Kept as one layer it is only ever masked,
    never dismembered.

    Generated by tools/build-icons.sh; see that script for why the art is
    inset rather than full-bleed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
