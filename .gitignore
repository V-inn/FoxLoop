# Rust
daemon/target/
console-daemon/target/
# A library's own lockfile is never used: whichever binary depends on it
# resolves the versions, in that binary's Cargo.lock.
crates/*/target/
crates/*/Cargo.lock
experiments/capture-latency-probe/target/

# Written by packaging/build-packages.sh: the wrapper and systemd unit with
# ~/.local/bin rewritten to /usr/bin. Generated on every packaging run, so a
# tracked copy could only ever be a stale one.
daemon/packaging/generated/

# C build artifacts (experiments)
experiments/**/*.o
experiments/evdi-bringup/evdi_test_client

# vendored evdi source clone (used to build a newer module for testing) --
# third-party GPL/LGPL source, not ours to track, keep it out of the repo
experiments/evdi-bringup/vendor/evdi/

# Android
*.apk
android-client/.gradle/
android-client/build/
android-client/*/build/
android-client/local.properties
android-client/.idea/
android-client/.cxx/
android-client/captures/

# Local working notes, not a public roadmap.
PUBLISHING-TODO.md
FoxLoop Console a USB console for a headless Pi.md

# Signing keys must never enter this repository. They live in the user's home
# directory (see app/build.gradle.kts, which reads them from
# ~/.gradle/gradle.properties). This is a guard against a stray copy, not the
# mechanism -- losing the keystore means no future build can upgrade an
# installed copy in place, and committing it would be worse.
*.jks
*.keystore
*.p12

# Claude Code's local state: session checkpoints, machine-local permissions, and
# working rules that reference paths on this machine. Untracked but not ignored
# meant a `git add -A` would have swept it in.
.claude/
